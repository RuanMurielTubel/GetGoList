rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if hasVerifiedEmail()
        && request.auth.uid == userId;
    }

    match /sharedLists/{listId} {
      function isOwner() {
        return hasVerifiedEmail() && request.auth.uid == resource.data.owner;
      }

      function hasSharedListAccess() {
        return isOwner() || (
          hasVerifiedEmail() &&
          resource.data.get('sharingEnded', false) != true && (
          (request.auth.token.email != null && request.auth.token.email in resource.data.get('allowedEmails', [])) ||
          resource.data.get('linkAccess', false) == true
          )
        );
      }

      function preservesOwnerControlledFields() {
        return request.resource.data.owner == resource.data.owner
          && request.resource.data.get('ownerEmail', '') == resource.data.get('ownerEmail', '')
          && request.resource.data.get('allowedEmails', []) == resource.data.get('allowedEmails', [])
          && request.resource.data.get('linkAccess', false) == resource.data.get('linkAccess', false)
          && request.resource.data.get('sharingEnded', false) == resource.data.get('sharingEnded', false)
          && request.resource.data.get('endedAt', null) == resource.data.get('endedAt', null)
          && request.resource.data.get('participantEmails', []) == resource.data.get('participantEmails', [])
          && request.resource.data.get('participants', {}) == resource.data.get('participants', {});
      }

      function preservesOwnerIdentity() {
        return request.resource.data.owner == resource.data.owner
          && request.resource.data.get('ownerEmail', '') == resource.data.get('ownerEmail', '');
      }

      allow create: if hasVerifiedEmail()
        && request.auth.uid == request.resource.data.owner
        && request.auth.token.email == request.resource.data.get('ownerEmail', '')
        && request.resource.data.get('sharingEnded', false) == false;
      allow update: if (
        isOwner() && preservesOwnerIdentity()
      ) || (
        hasSharedListAccess() && preservesOwnerControlledFields()
      );
      allow delete: if hasVerifiedEmail()
        && request.auth.uid == resource.data.owner;
      allow read: if hasSharedListAccess();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
