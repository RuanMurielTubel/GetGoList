rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    // Contas que sempre têm Cestão e nunca são cobradas — decisão manual,
    // não uma assinatura paga. Mesma lista em src/lib/shared/plan-limits.ts
    // (COMPLIMENTARY_CESTAO_EMAILS) e em public/app.js.
    function isComplimentaryCestao(email) {
      return email in ['gabrielamoraesn@gmail.com', 'tubel.mendes@gmail.com', 'contaparateste.getgolist@outlook.com', 'mariocatrileo@gmail.com'];
    }

    // Usuário sem documento de assinatura ainda (conta antiga, ou o
    // POST /api/billing/select-free-plan do cadastro ainda não rodou)
    // é tratado como "free" por padrão.
    function planId(userId) {
      return isComplimentaryCestao(request.auth.token.email)
        ? 'cestao'
        : (
          exists(/databases/$(database)/documents/users/$(userId)/billing/subscription)
            ? get(/databases/$(database)/documents/users/$(userId)/billing/subscription).data.get('plan', 'free')
            : 'free'
        );
    }

    function maxListsForPlan(plan) {
      return plan == 'cestao' ? 100000 : (plan == 'cesta' ? 10 : 1);
    }

    function canShareForPlan(plan) {
      return plan != 'free';
    }

    match /users/{userId} {
      // Nada é gravado no documento raiz hoje.
      allow read, write: if false;
    }

    match /users/{userId}/appData/lists {
      allow read: if hasVerifiedEmail() && request.auth.uid == userId;
      allow write: if hasVerifiedEmail()
        && request.auth.uid == userId
        && request.resource.data.lists is map
        && request.resource.data.currentListName is string
        && request.resource.data.currentListName.size() <= 80
        // Só trava a CRIAÇÃO de listas além do limite do plano. Um usuário
        // que já está acima do limite (conta antiga, downgrade) continua
        // editando/removendo itens normalmente — só não pode aumentar a
        // contagem de listas.
        && (
          request.resource.data.lists.size() <= maxListsForPlan(planId(userId))
          || request.resource.data.lists.size() <= resource.data.lists.size()
        );
    }

    match /users/{userId}/billing/subscription {
      allow read: if hasVerifiedEmail() && request.auth.uid == userId;
      // Autoritativo: só o Admin SDK (rotas server) grava aqui.
      allow write: if false;
    }

    match /users/{userId}/billing/subscription/payments/{paymentId} {
      allow read: if hasVerifiedEmail() && request.auth.uid == userId;
      allow write: if false;
    }

    match /sharedLists/{listId} {
      function isOwner() {
        return hasVerifiedEmail() && request.auth.uid == resource.data.owner;
      }

      function hasSharedListAccess() {
        return isOwner() || (
          hasVerifiedEmail() &&
          resource.data.get('sharingEnded', false) != true && (
          (request.auth.token.email != null && request.auth.token.email in resource.data.get('allowedEmails', [])) ||
          (request.auth.token.email != null && request.auth.token.email in resource.data.get('participantEmails', [])) ||
          resource.data.get('linkAccess', false) == true
          )
        );
      }

      function preservesOwnerControlledFields() {
        return request.resource.data.owner == resource.data.owner
          && request.resource.data.get('ownerEmail', '') == resource.data.get('ownerEmail', '')
          && request.resource.data.get('allowedEmails', []) == resource.data.get('allowedEmails', [])
          && request.resource.data.get('linkAccess', false) == resource.data.get('linkAccess', false)
          && request.resource.data.get('sharingEnded', false) == resource.data.get('sharingEnded', false)
          && request.resource.data.get('endedAt', null) == resource.data.get('endedAt', null)
          && request.resource.data.get('participantEmails', []) == resource.data.get('participantEmails', [])
          && request.resource.data.get('participants', {}) == resource.data.get('participants', {});
      }

      function preservesOwnerIdentity() {
        return request.resource.data.owner == resource.data.owner
          && request.resource.data.get('ownerEmail', '') == resource.data.get('ownerEmail', '');
      }

      // Convidados só editam o conteúdo da lista (itens, histórico, setores).
      // Nome da lista e orçamento definido (initialBalance) são decisões do
      // dono; `balance` fica de fora porque varia normalmente conforme os
      // próprios convidados incluem/removem produtos.
      function preservesListIdentityForGuests() {
        let listName = resource.data.currentListName;
        return request.resource.data.currentListName == listName
          && request.resource.data.lists[listName].initialBalance
            == resource.data.lists[listName].initialBalance;
      }

      function hasValidSharedListShape() {
        let listName = request.resource.data.currentListName;
        let listData = request.resource.data.lists[listName];
        return request.resource.data.keys().hasOnly([
            'owner', 'ownerEmail', 'allowedEmails', 'linkAccess',
            'sharingEnded', 'endedAt', 'endedBy', 'participantEmails', 'participants',
            'lists', 'currentListName', 'lastEditedBy', 'lastEditedByEmail',
            'lastEditedAt', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.owner is string
          && request.resource.data.owner.size() <= 128
          && request.resource.data.get('ownerEmail', '') is string
          && request.resource.data.get('ownerEmail', '').size() <= 254
          && request.resource.data.allowedEmails is list
          && request.resource.data.allowedEmails.size() <= 21
          && request.resource.data.linkAccess is bool
          && request.resource.data.sharingEnded is bool
          && request.resource.data.get('endedBy', '') is string
          && request.resource.data.get('endedBy', '').size() <= 128
          && request.resource.data.get('participantEmails', []) is list
          && request.resource.data.get('participantEmails', []).size() <= 100
          && request.resource.data.get('participants', {}) is map
          && request.resource.data.get('participants', {}).size() <= 100
          && request.resource.data.get('lastEditedBy', '') is string
          && request.resource.data.get('lastEditedBy', '').size() <= 80
          && request.resource.data.get('lastEditedByEmail', '') is string
          && request.resource.data.get('lastEditedByEmail', '').size() <= 254
          && request.resource.data.currentListName is string
          && request.resource.data.currentListName.size() > 0
          && request.resource.data.currentListName.size() <= 80
          && request.resource.data.lists is map
          && request.resource.data.lists.size() == 1
          && listName in request.resource.data.lists
          && listData is map
          && listData.keys().hasOnly(['items', 'history', 'sectorOrder', 'balance', 'initialBalance'])
          && listData.items is list
          && listData.items.size() <= 500
          && listData.history is list
          && listData.history.size() <= 1000
          && listData.get('sectorOrder', []) is list
          && listData.get('sectorOrder', []).size() <= 50
          && listData.balance is number
          && listData.initialBalance is number;
      }

      allow create: if hasVerifiedEmail()
        && request.auth.uid == request.resource.data.owner
        && request.auth.token.email == request.resource.data.get('ownerEmail', '')
        && request.resource.data.get('sharingEnded', false) == false
        && canShareForPlan(planId(request.auth.uid))
        && hasValidSharedListShape();
      allow update: if (
        isOwner() && preservesOwnerIdentity() && hasValidSharedListShape()
      ) || (
        hasSharedListAccess() && preservesOwnerControlledFields()
          && preservesListIdentityForGuests() && hasValidSharedListShape()
      );
      allow delete: if hasVerifiedEmail()
        && request.auth.uid == resource.data.owner;
      allow read: if hasSharedListAccess();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
